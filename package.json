{
  "name": "shogun-contracts",
  "version": "1.3.1",
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./contracts-config": "./contracts-config.js",
    "./deployments": "./deployments.js"
  },
  "files": [
    "index.js",
    "contracts-config.js",
    "deployments.js",
    "deployments.json"
  ],
  "scripts": {
    "chain": "npx hardhat node",
    "deploy:local": "yarn hardhat ignition deploy ./ignition/modules/Protocol.ts --network localhost",
    "deploy:sepolia": "yarn hardhat ignition deploy ./ignition/modules/Protocol.ts --network sepolia --verify",
    "deploy:stealthPool:local": "yarn hardhat ignition deploy ./ignition/modules/stealthPool.ts --network localhost",
    "deploy:stealthPool:sepolia": "yarn hardhat ignition deploy ./ignition/modules/stealthPool.ts --network sepolia --verify",
    "deploy:registry:local": "yarn hardhat ignition deploy ./ignition/modules/relayRegistry.ts --network localhost",
    "deploy:registry:baseSepolia": "yarn hardhat ignition deploy ./ignition/modules/relayRegistry.ts --network baseSepolia --verify",
    "reset:deployments:baseSepolia": "Remove-Item -Recurse -Force ignition\\deployments\\chain-84532 -ErrorAction SilentlyContinue",
    "post-deployment": "ts-node scripts/post-deployment.ts",
    "encrypt": "dotenvenc -e .env -o .env.enc",
    "decrypt": "dotenvenc -d .env.enc -o .env"
  },
  "author": "scobru",
  "license": "MIT",
  "description": "Shogun Contracts",
  "dependencies": {
    "@openzeppelin/contracts": "^5.3.0",
    "@tka85/dotenvenc": "^5.4.2",
    "dotenv": "^16.5.0",
    "gun": "^0.2020.1240",
    "hardhat": "^2.22.19",
    "keccak256": "^1.0.6"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": ">=9.1.0",
    "@types/node": ">=18.0.0",
    "chai": "^4.2.0",
    "ethers": "^6.4.0",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-coverage": "^0.8.0",
    "ts-node": ">=8.0.0",
    "typechain": "^8.3.0",
    "typescript": ">=4.5.0"
  }
}
